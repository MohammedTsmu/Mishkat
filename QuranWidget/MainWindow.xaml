<Window x:Class="QuranWidget.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Quran Widget"
        Width="412"
        SizeToContent="Height"
        WindowStyle="None"
        ResizeMode="NoResize"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        SourceInitialized="OnSourceInitialized"
        LocationChanged="Window_LocationChanged"
        Closing="Window_Closing">

    <Window.ContextMenu>
        <ContextMenu Style="{StaticResource DarkContextMenu}" Opened="ContextMenu_Opened">
            <MenuItem x:Name="MenuDaily" Header="Verse of the Day" Style="{StaticResource DarkMenuItem}" Click="MenuDaily_Click"/>
            <MenuItem x:Name="MenuNew" Header="New Verse Widget" Style="{StaticResource DarkMenuItem}" Click="MenuNew_Click"/>
            <Separator Style="{StaticResource DarkSeparator}"/>
            <MenuItem x:Name="MenuFavorites" Header="Favorites" Style="{StaticResource DarkMenuItem}" Click="MenuFavorites_Click"/>
            <MenuItem x:Name="MenuSaveImage" Header="Save verse as image" Style="{StaticResource DarkMenuItem}" Click="MenuSaveImage_Click"/>
            <Separator Style="{StaticResource DarkSeparator}"/>
            <MenuItem x:Name="MenuTopmost" Header="Always on top" Style="{StaticResource DarkMenuItem}" Click="MenuTopmost_Click"/>
            <MenuItem x:Name="MenuPin" Header="Pin to desktop" Style="{StaticResource DarkMenuItem}" Click="MenuPin_Click"/>
            <MenuItem x:Name="MenuStartup" Header="Start with Windows" Style="{StaticResource DarkMenuItem}" Click="MenuStartup_Click"/>
            <Separator Style="{StaticResource DarkSeparator}"/>
            <MenuItem x:Name="MenuExit" Header="Exit" Style="{StaticResource DarkMenuItem}" Click="MenuExit_Click"/>
        </ContextMenu>
    </Window.ContextMenu>

    <Border x:Name="Card" CornerRadius="24" BorderThickness="1" Margin="14">
        <Border.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="{DynamicResource Card1Color}" Offset="0"/>
                <GradientStop Color="{DynamicResource Card2Color}" Offset="0.55"/>
                <GradientStop Color="{DynamicResource Card3Color}" Offset="1"/>
            </LinearGradientBrush>
        </Border.Background>
        <Border.BorderBrush>
            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="{DynamicResource Border1Color}" Offset="0"/>
                <GradientStop Color="{DynamicResource Border2Color}" Offset="0.5"/>
                <GradientStop Color="{DynamicResource Border3Color}" Offset="1"/>
            </LinearGradientBrush>
        </Border.BorderBrush>
        <Border.Effect>
            <DropShadowEffect Color="{DynamicResource ShadowColor}" BlurRadius="22" ShadowDepth="6" Opacity="0.5"/>
        </Border.Effect>

        <Grid Margin="20,14,20,16" Background="Transparent" MouseLeftButtonDown="Card_MouseLeftButtonDown">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- ============ header ============ -->
            <Grid Grid.Row="0">
                <StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#x66E;" FontFamily="{StaticResource FontAmiri}" FontSize="13"
                                   Foreground="{DynamicResource Gold}" VerticalAlignment="Center" Margin="0,0,7,2"/>
                        <TextBlock x:Name="ModeText" Text="VERSE OF THE DAY" FontSize="11" FontWeight="SemiBold"
                                   Foreground="{DynamicResource Gold}" VerticalAlignment="Center"/>
                    </StackPanel>
                    <TextBlock x:Name="DateText" Text="" FontSize="11.5"
                               Foreground="{DynamicResource TextFaint}" Margin="20,3,0,0"/>
                    <TextBlock x:Name="PrayerText" Text="" FontSize="11" Visibility="Collapsed"
                               Foreground="{DynamicResource GoldDim}" Margin="20,2,0,0"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top">
                    <!-- wifi-off indicator: pure vector icon, shown only when there is no internet -->
                    <Grid x:Name="OfflineIcon" Visibility="Collapsed" Width="18" Height="18"
                          VerticalAlignment="Center" Margin="0,0,8,2"
                          ToolTip="No internet — recitation is unavailable. Reading and copying work offline."
                          Background="Transparent">
                        <Path Stroke="#E8A15A" StrokeThickness="1.7" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                              Data="M 2.2,6.8 A 8.6,8.6 0 0 1 15.8,6.8"/>
                        <Path Stroke="#E8A15A" StrokeThickness="1.7" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                              Data="M 4.9,9.6 A 4.6,4.6 0 0 1 13.1,9.6"/>
                        <Ellipse Width="2.2" Height="2.2" Fill="#F0C87E"
                                 HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,1.2"/>
                        <Line X1="2.5" Y1="2.5" X2="15.5" Y2="15.5" Stroke="#E06552" StrokeThickness="1.9"
                              StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                    </Grid>
                    <Button x:Name="SearchButton" Style="{StaticResource IconButton}" Content="&#xE721;"
                            ToolTip="Search the Quran (text or verse number like 2:255)"
                            Margin="6,0,0,0" Click="SearchButton_Click"/>
                    <Button Style="{StaticResource IconButton}" Content="&#xE713;" ToolTip="Settings"
                            Click="Settings_Click"/>
                    <Button Style="{StaticResource IconButton}" Content="&#xE711;" ToolTip="Hide (stays in tray)"
                            Margin="6,0,0,0" Click="Hide_Click"/>
                </StackPanel>
            </Grid>

            <!-- ============ body ============ -->
            <Grid x:Name="BodyGrid" Grid.Row="1">
                <Grid.RenderTransform>
                    <TranslateTransform x:Name="BodyTt"/>
                </Grid.RenderTransform>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- surah header -->
                <StackPanel Grid.Row="0" Margin="0,12,0,0" HorizontalAlignment="Center">
                    <TextBlock x:Name="SurahArabicText" FlowDirection="RightToLeft"
                               FontFamily="{StaticResource FontAmiri}" FontSize="17"
                               Foreground="{DynamicResource Gold}" TextAlignment="Center" Text=""/>
                    <TextBlock x:Name="SurahEnglishText" FontSize="11.5"
                               Foreground="{DynamicResource TextSecondary}" TextAlignment="Center"
                               Margin="0,2,0,0" Text=""/>
                </StackPanel>

                <!-- arabic verse -->
                <ScrollViewer x:Name="ArabicScroll" Grid.Row="1" MaxHeight="430" Margin="0,10,0,0" FlowDirection="RightToLeft"
                              Style="{StaticResource ThinScrollViewer}" VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled">
                    <TextBlock x:Name="ArabicText" FlowDirection="RightToLeft"
                               FontFamily="{StaticResource FontQuran}" FontSize="24"
                               Foreground="{DynamicResource TextPrimary}" TextAlignment="Center"
                               TextWrapping="Wrap" Text=""/>
                </ScrollViewer>

                <!-- divider -->
                <Grid x:Name="DividerGrid" Grid.Row="2" Margin="0,12,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition/>
                    </Grid.ColumnDefinitions>
                    <Rectangle Grid.Column="0" Height="1" VerticalAlignment="Center">
                        <Rectangle.Fill>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                <GradientStop Color="{DynamicResource A00Color}" Offset="0"/>
                                <GradientStop Color="{DynamicResource A66Color}" Offset="1"/>
                            </LinearGradientBrush>
                        </Rectangle.Fill>
                    </Rectangle>
                    <TextBlock Grid.Column="1" Text="&#x2726;" FontSize="9"
                               Foreground="{DynamicResource GoldDim}" Margin="8,0,8,3" VerticalAlignment="Center"/>
                    <Rectangle Grid.Column="2" Height="1" VerticalAlignment="Center">
                        <Rectangle.Fill>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                <GradientStop Color="{DynamicResource A66Color}" Offset="0"/>
                                <GradientStop Color="{DynamicResource A00Color}" Offset="1"/>
                            </LinearGradientBrush>
                        </Rectangle.Fill>
                    </Rectangle>
                </Grid>

                <!-- translation -->
                <ScrollViewer x:Name="TranslationScroll" Grid.Row="3" MaxHeight="210" Margin="0,10,0,0"
                              Style="{StaticResource ThinScrollViewer}" VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled">
                    <TextBlock x:Name="TranslationText" FontSize="13" LineHeight="19.5"
                               Foreground="{DynamicResource TextSecondary}" TextAlignment="Center"
                               TextWrapping="Wrap" Text=""/>
                </ScrollViewer>

                <!-- footer -->
                <Grid Grid.Row="4" Margin="0,12,0,2">
                    <TextBlock x:Name="StatusText" Text="" FontSize="11"
                               Foreground="{DynamicResource TextFaint}" VerticalAlignment="Center"
                               HorizontalAlignment="Left" Margin="2,0,0,0"/>
                    <!-- skeleton shimmer shown while recitation audio is buffering -->
                    <Border x:Name="ShimmerBorder" Visibility="Collapsed" Opacity="0"
                            Height="4" Width="140" CornerRadius="2"
                            HorizontalAlignment="Left" VerticalAlignment="Center" Margin="2,0,0,0">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                <LinearGradientBrush.RelativeTransform>
                                    <TranslateTransform x:Name="ShimmerTt" X="-1"/>
                                </LinearGradientBrush.RelativeTransform>
                                <GradientStop Color="{DynamicResource A00Color}" Offset="0"/>
                                <GradientStop Color="{DynamicResource AA8Color}" Offset="0.5"/>
                                <GradientStop Color="{DynamicResource A00Color}" Offset="1"/>
                            </LinearGradientBrush>
                        </Border.Background>
                    </Border>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button x:Name="PlayButton" Style="{StaticResource IconButton}" Content="&#xE768;"
                                ToolTip="Play recitation" Click="PlayRecitation_Click"/>
                        <Button x:Name="TtsButton" Style="{StaticResource IconButton}" Content="&#xE767;"
                                ToolTip="Read the meaning aloud" Margin="6,0,0,0" Click="SpeakMeaning_Click"/>
                        <Button x:Name="NextButton" Style="{StaticResource IconButton}" Content="&#xE72C;"
                                ToolTip="Another verse" Margin="6,0,0,0" Click="NextVerse_Click"/>
                        <Button x:Name="FavoriteButton" Style="{StaticResource IconButton}" Content="&#xE734;"
                                ToolTip="Favorites — tap to save this verse" Margin="6,0,0,0" Click="Favorite_Click"/>
                        <Button x:Name="CopyButton" Style="{StaticResource IconButton}" Content="&#xE8C8;"
                                ToolTip="Copy" Margin="6,0,0,0" Click="Copy_Click"/>
                    </StackPanel>
                </Grid>

                <!-- search popup -->
                <Popup x:Name="SearchPopup" PlacementTarget="{Binding ElementName=SearchButton}"
                       Placement="Bottom" StaysOpen="False" AllowsTransparency="True"
                       PopupAnimation="Fade" Closed="SearchPopup_Closed">
                    <Border Background="{DynamicResource Surface}" BorderBrush="{DynamicResource SurfaceBorder}" BorderThickness="1"
                            CornerRadius="10" Padding="8" Margin="10" Width="340" MaxHeight="380">
                        <Border.Effect>
                            <DropShadowEffect Color="{DynamicResource ShadowColor}" BlurRadius="16" ShadowDepth="3" Opacity="0.45"/>
                        </Border.Effect>
                        <StackPanel>
                            <Border CornerRadius="9" BorderBrush="{DynamicResource A3F}" BorderThickness="1"
                                    Background="{DynamicResource HoverSoft}" Padding="9,6">
                                <TextBox x:Name="SearchBox" BorderThickness="0" Background="Transparent"
                                         Foreground="{DynamicResource TextPrimary}" CaretBrush="{DynamicResource Gold}"
                                         FontSize="12.5" VerticalContentAlignment="Center"
                                         ToolTip="Type words to find verses, or a reference like 2:255 to jump"
                                         TextChanged="SearchBox_TextChanged"
                                         KeyDown="SearchBox_KeyDown"/>
                            </Border>
                            <TextBlock x:Name="SearchBoxHint" Text="Type words to search, or 2:255 to jump to a verse"
                                       FontSize="10" Foreground="{DynamicResource TextFaint}" Margin="8,5,0,4"/>
                            <ListBox x:Name="SearchList" Background="Transparent" BorderThickness="0" Visibility="Collapsed"
                                     ItemContainerStyle="{StaticResource DarkListBoxItem}"
                                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                     MaxHeight="260" Margin="0,2,0,0"
                                     SelectionChanged="SearchList_SelectionChanged"/>
                        </StackPanel>
                    </Border>
                </Popup>

                <!-- favorites popup -->
                <Popup x:Name="FavoritesPopup" PlacementTarget="{Binding ElementName=FavoriteButton}"
                       Placement="Top" StaysOpen="False" AllowsTransparency="True"
                       PopupAnimation="Fade" Closed="FavoritesPopup_Closed">
                    <Border Background="{DynamicResource Surface}" BorderBrush="{DynamicResource SurfaceBorder}" BorderThickness="1"
                            CornerRadius="10" Padding="6" Margin="10" Width="330" MaxHeight="360">
                        <Border.Effect>
                            <DropShadowEffect Color="{DynamicResource ShadowColor}" BlurRadius="16" ShadowDepth="3" Opacity="0.45"/>
                        </Border.Effect>
                        <StackPanel>
                            <TextBlock Text="FAVORITES" FontSize="10" Foreground="{DynamicResource TextFaint}" Margin="8,4,0,6"/>
                            <ListBox x:Name="FavoritesList" Background="Transparent" BorderThickness="0"
                                     ItemContainerStyle="{StaticResource DarkListBoxItem}"
                                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                     MaxHeight="280"
                                     SelectionChanged="FavoritesList_SelectionChanged"/>
                            <TextBlock x:Name="FavoritesEmpty" Text="Tap the star to keep a verse here."
                                       FontSize="11" Foreground="{DynamicResource TextFaint}" Margin="8,2,0,6"/>
                        </StackPanel>
                    </Border>
                </Popup>

                <!-- settings overlay -->
                <Border x:Name="SettingsPanel" Grid.Row="0" Grid.RowSpan="5" CornerRadius="16"
                        Background="{DynamicResource Surface}" BorderBrush="{DynamicResource SurfaceBorder}" BorderThickness="1"
                        Padding="18,10,18,14" Visibility="Collapsed">
                    <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <!-- fixed header: the close ✕ never scrolls away, so it can't be
                         confused with the widget's own hide ✕ underneath -->
                    <Grid Grid.Row="0" Margin="0,4,0,6">
                        <TextBlock x:Name="SettingsTitle" Text="Settings" FontSize="13.5" FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextPrimary}" VerticalAlignment="Center"/>
                        <Button Style="{StaticResource IconButton}" Width="28" Height="28" FontSize="11"
                                Content="&#xE711;" HorizontalAlignment="Right" Click="SettingsClose_Click"/>
                    </Grid>
                    <ScrollViewer Grid.Row="1" MaxHeight="540" VerticalScrollBarVisibility="Auto"
                                  Style="{StaticResource ThinScrollViewer}"
                                  ScrollChanged="SettingsScroll_Changed">
                        <StackPanel>


                            <TextBlock x:Name="ReciterLabel" Text="RECITER" FontSize="10" Foreground="{DynamicResource TextFaint}" Margin="0,14,0,5"/>
                            <ToggleButton x:Name="ReciterToggle" Style="{StaticResource ComboToggle}"
                                          Checked="ReciterToggle_Changed" Unchecked="ReciterToggle_Changed"/>
                            <Popup x:Name="ReciterPopup" PlacementTarget="{Binding ElementName=ReciterToggle}"
                                   Placement="Top" StaysOpen="False" AllowsTransparency="True"
                                   PopupAnimation="Fade" Closed="ReciterPopup_Closed">
                                <Border Background="{DynamicResource Surface}" BorderBrush="{DynamicResource SurfaceBorder}" BorderThickness="1"
                                        CornerRadius="10" Padding="4" Margin="10" MinWidth="215" MaxHeight="300">
                                    <Border.Effect>
                                        <DropShadowEffect Color="{DynamicResource ShadowColor}" BlurRadius="16" ShadowDepth="3" Opacity="0.45"/>
                                    </Border.Effect>
                                    <ListBox x:Name="ReciterList" Background="Transparent" BorderThickness="0"
                                             ItemContainerStyle="{StaticResource DarkListBoxItem}"
                                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                             SelectionChanged="ReciterList_SelectionChanged"/>
                                </Border>
                            </Popup>

                            <TextBlock x:Name="TranslationLabel" Text="TRANSLATION" FontSize="10" Foreground="{DynamicResource TextFaint}" Margin="0,14,0,5"/>
                            <ToggleButton x:Name="TranslationToggle" Style="{StaticResource ComboToggle}"
                                          Checked="TranslationToggle_Changed" Unchecked="TranslationToggle_Changed"/>
                            <Popup x:Name="TranslationPopup" PlacementTarget="{Binding ElementName=TranslationToggle}"
                                   Placement="Top" StaysOpen="False" AllowsTransparency="True"
                                   PopupAnimation="Fade" Closed="TranslationPopup_Closed">
                                <Border Background="{DynamicResource Surface}" BorderBrush="{DynamicResource SurfaceBorder}" BorderThickness="1"
                                        CornerRadius="10" Padding="4" Margin="10" MinWidth="215" MaxHeight="300">
                                    <Border.Effect>
                                        <DropShadowEffect Color="{DynamicResource ShadowColor}" BlurRadius="16" ShadowDepth="3" Opacity="0.45"/>
                                    </Border.Effect>
                                    <ListBox x:Name="TranslationList" Background="Transparent" BorderThickness="0"
                                             ItemContainerStyle="{StaticResource DarkListBoxItem}"
                                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                             SelectionChanged="TranslationList_SelectionChanged"/>
                                </Border>
                            </Popup>
                            <CheckBox x:Name="ShowTranslationCheck" Style="{StaticResource DarkCheck}"
                                      Content="Show translation" Margin="0,10,0,0"
                                      Checked="ShowTranslation_Changed" Unchecked="ShowTranslation_Changed"/>

                            <TextBlock x:Name="ThemeLabel" Text="THEME" FontSize="10" Foreground="{DynamicResource TextFaint}" Margin="0,14,0,5"/>
                            <ToggleButton x:Name="ThemeToggle" Style="{StaticResource ComboToggle}"
                                          Checked="ThemeToggle_Changed" Unchecked="ThemeToggle_Changed"/>
                            <Popup x:Name="ThemePopup" PlacementTarget="{Binding ElementName=ThemeToggle}"
                                   Placement="Top" StaysOpen="False" AllowsTransparency="True"
                                   PopupAnimation="Fade" Closed="ThemePopup_Closed">
                                <Border Background="{DynamicResource Surface}" BorderBrush="{DynamicResource SurfaceBorder}" BorderThickness="1"
                                        CornerRadius="10" Padding="4" Margin="10" MinWidth="215" MaxHeight="300">
                                    <Border.Effect>
                                        <DropShadowEffect Color="{DynamicResource ShadowColor}" BlurRadius="16" ShadowDepth="3" Opacity="0.45"/>
                                    </Border.Effect>
                                    <ListBox x:Name="ThemeList" Background="Transparent" BorderThickness="0"
                                             ItemContainerStyle="{StaticResource DarkListBoxItem}"
                                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                             SelectionChanged="ThemeList_SelectionChanged"/>
                                </Border>
                            </Popup>

                            <TextBlock x:Name="OpacityLabel" Text="OPACITY" FontSize="10" Foreground="{DynamicResource TextFaint}" Margin="0,14,0,5"/>
                            <Slider x:Name="OpacitySlider" Style="{StaticResource GoldSlider}" Minimum="0.35" Maximum="1.0"
                                    IsMoveToPointEnabled="True" ValueChanged="Opacity_ValueChanged"/>
                            <TextBlock x:Name="FontSizeLabel" Text="ARABIC FONT SIZE" FontSize="10" Foreground="{DynamicResource TextFaint}" Margin="0,14,0,5"/>
                            <Slider x:Name="FontSizeSlider" Style="{StaticResource GoldSlider}" Minimum="18" Maximum="40"
                                    IsSnapToTickEnabled="True" TickFrequency="2"
                                    IsMoveToPointEnabled="True" ValueChanged="FontSize_ValueChanged"/>

                            <CheckBox x:Name="TopmostCheck" Style="{StaticResource DarkCheck}" Content="Always on top"
                                      Margin="0,16,0,0" Checked="Topmost_Changed" Unchecked="Topmost_Changed"/>
                            <CheckBox x:Name="PinCheck" Style="{StaticResource DarkCheck}"
                                      Content="Pin to the desktop background" Margin="0,10,0,0"
                                      Checked="Pin_Changed" Unchecked="Pin_Changed"/>
                            <CheckBox x:Name="StartupCheck" Style="{StaticResource DarkCheck}"
                                      Content="Start with Windows" Margin="0,10,0,0"
                                      Checked="Startup_Changed" Unchecked="Startup_Changed"/>
                            <CheckBox x:Name="PrayerCheck" Style="{StaticResource DarkCheck}"
                                      Content="Show next prayer time (auto-locates once)" Margin="0,10,0,0"
                                      Checked="Prayer_Changed" Unchecked="Prayer_Changed"/>

                            <TextBlock x:Name="ContinueLabel" Text="CONTINUOUS READING" FontSize="10" Foreground="{DynamicResource TextFaint}" Margin="0,14,0,5"/>
                            <CheckBox x:Name="ContinueCheck" Style="{StaticResource DarkCheck}"
                                      Content="Keep reading — continue to the next verses"
                                      Checked="Continue_Changed" Unchecked="Continue_Changed"/>
                            <ToggleButton x:Name="StopAtToggle" Style="{StaticResource ComboToggle}"
                                          IsEnabled="{Binding IsChecked, ElementName=ContinueCheck}"
                                          Margin="0,8,0,0"
                                          Checked="StopAtToggle_Changed" Unchecked="StopAtToggle_Changed"/>
                            <Popup x:Name="StopAtPopup" PlacementTarget="{Binding ElementName=StopAtToggle}"
                                   Placement="Top" StaysOpen="False" AllowsTransparency="True"
                                   PopupAnimation="Fade" Closed="StopAtPopup_Closed">
                                <Border Background="{DynamicResource Surface}" BorderBrush="{DynamicResource SurfaceBorder}" BorderThickness="1"
                                        CornerRadius="10" Padding="4" Margin="10" MinWidth="215" MaxHeight="300">
                                    <Border.Effect>
                                        <DropShadowEffect Color="{DynamicResource ShadowColor}" BlurRadius="16" ShadowDepth="3" Opacity="0.45"/>
                                    </Border.Effect>
                                    <ListBox x:Name="StopAtList" Background="Transparent" BorderThickness="0"
                                             ItemContainerStyle="{StaticResource DarkListBoxItem}"
                                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                             SelectionChanged="StopAtList_SelectionChanged"/>
                                </Border>
                            </Popup>
                            <TextBlock x:Name="ResumeText" Text="" FontSize="11" TextWrapping="Wrap"
                                       Foreground="{DynamicResource TextFaint}" Margin="0,6,0,0"/>
                            <Button x:Name="ClearResumeButton" Style="{StaticResource ComboButton}" Margin="0,8,0,0"
                                    Content="Clear saved reading position" Click="ClearResume_Click"/>

                            <TextBlock x:Name="SleepLabel2" Text="SLEEP TIMER" FontSize="10" Foreground="{DynamicResource TextFaint}" Margin="0,14,0,5"/>
                            <ToggleButton x:Name="SleepToggle" Style="{StaticResource ComboToggle}"
                                          Checked="SleepToggle_Changed" Unchecked="SleepToggle_Changed"/>
                            <Popup x:Name="SleepPopup" PlacementTarget="{Binding ElementName=SleepToggle}"
                                   Placement="Top" StaysOpen="False" AllowsTransparency="True"
                                   PopupAnimation="Fade" Closed="SleepPopup_Closed">
                                <Border Background="{DynamicResource Surface}" BorderBrush="{DynamicResource SurfaceBorder}" BorderThickness="1"
                                        CornerRadius="10" Padding="4" Margin="10" MinWidth="215" MaxHeight="300">
                                    <Border.Effect>
                                        <DropShadowEffect Color="{DynamicResource ShadowColor}" BlurRadius="16" ShadowDepth="3" Opacity="0.45"/>
                                    </Border.Effect>
                                    <ListBox x:Name="SleepList" Background="Transparent" BorderThickness="0"
                                             ItemContainerStyle="{StaticResource DarkListBoxItem}"
                                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                             SelectionChanged="SleepList_SelectionChanged"/>
                                </Border>
                            </Popup>

                            <TextBlock x:Name="DownloadsLabel" Text="DOWNLOADS" FontSize="10" Foreground="{DynamicResource TextFaint}" Margin="0,14,0,5"/>
                            <TextBlock x:Name="DownloadsHint" Text="" FontSize="11" TextWrapping="Wrap"
                                       Foreground="{DynamicResource TextFaint}" Margin="0,0,0,8"/>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="8"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock x:Name="DlReciterCaption" Text="Reciter" FontSize="10" Foreground="{DynamicResource TextFaint}" Margin="0,0,0,3"/>
                                    <ToggleButton x:Name="DlReciterToggle" Style="{StaticResource ComboToggle}"
                                                  Checked="DlReciterToggle_Changed" Unchecked="DlReciterToggle_Changed"/>
                                    <Popup x:Name="DlReciterPopup" PlacementTarget="{Binding ElementName=DlReciterToggle}"
                                           Placement="Top" StaysOpen="False" AllowsTransparency="True"
                                           PopupAnimation="Fade" Closed="DlReciterPopup_Closed">
                                        <Border Background="{DynamicResource Surface}" BorderBrush="{DynamicResource SurfaceBorder}" BorderThickness="1"
                                                CornerRadius="10" Padding="4" Margin="10" MinWidth="215" MaxHeight="300">
                                            <Border.Effect>
                                                <DropShadowEffect Color="{DynamicResource ShadowColor}" BlurRadius="16" ShadowDepth="3" Opacity="0.45"/>
                                            </Border.Effect>
                                            <ListBox x:Name="DlReciterList" Background="Transparent" BorderThickness="0"
                                                     ItemContainerStyle="{StaticResource DarkListBoxItem}"
                                                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                                     SelectionChanged="DlReciterList_SelectionChanged"/>
                                        </Border>
                                    </Popup>
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock x:Name="DlScopeCaption" Text="Content" FontSize="10" Foreground="{DynamicResource TextFaint}" Margin="0,0,0,3"/>
                                    <ToggleButton x:Name="DlScopeToggle" Style="{StaticResource ComboToggle}"
                                                  Checked="DlScopeToggle_Changed" Unchecked="DlScopeToggle_Changed"/>
                                    <Popup x:Name="DlScopePopup" PlacementTarget="{Binding ElementName=DlScopeToggle}"
                                           Placement="Top" StaysOpen="False" AllowsTransparency="True"
                                           PopupAnimation="Fade" Closed="DlScopePopup_Closed">
                                        <Border Background="{DynamicResource Surface}" BorderBrush="{DynamicResource SurfaceBorder}" BorderThickness="1"
                                                CornerRadius="10" Padding="4" Margin="10" MinWidth="215" MaxHeight="340">
                                            <Border.Effect>
                                                <DropShadowEffect Color="{DynamicResource ShadowColor}" BlurRadius="16" ShadowDepth="3" Opacity="0.45"/>
                                            </Border.Effect>
                                            <ListBox x:Name="DlScopeList" Background="Transparent" BorderThickness="0"
                                                     ItemContainerStyle="{StaticResource DarkListBoxItem}"
                                                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                                     SelectionChanged="DlScopeList_SelectionChanged"/>
                                        </Border>
                                    </Popup>
                                </StackPanel>
                            </Grid>
                            <Button x:Name="DownloadStartButton" Style="{StaticResource ComboButton}" Margin="0,8,0,0"
                                    Click="DownloadStart_Click"/>
                            <Grid x:Name="DownloadsProgressPanel" Visibility="Collapsed" Margin="0,8,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <ProgressBar x:Name="DownloadsProgress" Height="8" Minimum="0" Maximum="100"
                                             Foreground="{DynamicResource Gold}" Background="{DynamicResource A26}"
                                             BorderThickness="0" VerticalAlignment="Center"/>
                                <Button x:Name="DownloadCancelButton" Grid.Column="1" Style="{StaticResource IconButton}"
                                        Content="&#xE711;" Margin="8,0,0,0" Click="DownloadCancel_Click"/>
                            </Grid>
                            <TextBlock x:Name="DownloadsStatus" Text="" FontSize="11" TextWrapping="Wrap"
                                       Foreground="{DynamicResource TextFaint}" Margin="0,6,0,0"/>

                            <TextBlock x:Name="UpdatesLabel" Text="UPDATES" FontSize="10" Foreground="{DynamicResource TextFaint}" Margin="0,14,0,5"/>
                            <Button x:Name="CheckUpdatesButton" Style="{StaticResource ComboButton}"
                                    Content="Check for updates now" Click="CheckUpdates_Click"/>
                            <TextBlock x:Name="LanguageLabel" Text="LANGUAGE" FontSize="10" Foreground="{DynamicResource TextFaint}" Margin="0,14,0,5"/>
                            <Button x:Name="LangButton" Style="{StaticResource ComboButton}"
                                    Click="Language_Click"/>

                            <TextBlock Text="Recitation: cdn.islamic.network  ·  Translations: api.alquran.cloud"
                                       FontSize="10" Foreground="{DynamicResource TextFaint}" Margin="0,14,0,0" TextWrapping="Wrap"/>
                        </StackPanel>
                    </ScrollViewer>
                    <!-- bottom fade: signals there is more to scroll below -->
                    <Border x:Name="SettingsFade" Grid.Row="1" IsHitTestVisible="False" Height="34"
                            VerticalAlignment="Bottom" Margin="0,0,0,-6">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                <GradientStop Color="#00000000" Offset="0"/>
                                <GradientStop Color="{DynamicResource SurfaceColor}" Offset="0.6"/>
                            </LinearGradientBrush>
                        </Border.Background>
                    </Border>
                    <TextBlock x:Name="SettingsScrollHint" Grid.Row="1" IsHitTestVisible="False" Text="Scroll for more ↓"
                               FontSize="10" Foreground="{DynamicResource TextFaint}"
                               HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,-16"/>
                    </Grid>
                </Border>
            </Grid>
        </Grid>
    </Border>
</Window>

